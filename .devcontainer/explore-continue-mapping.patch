+bool FrontierSearch::findSurveyGoal(
+    const geometry_msgs::msg::Point& position,
+    const std::deque<geometry_msgs::msg::Point>& visited,
+    const std::vector<geometry_msgs::msg::Point>& failed,
+    geometry_msgs::msg::Point& target) const
+{
+  using nav2_costmap_2d::INSCRIBED_INFLATED_OBSTACLE;
+  constexpr double min_distance = 0.65;
+  constexpr double desired_distance = 1.5;
+  constexpr double max_path_length = 2.5;
+
+  std::lock_guard<nav2_costmap_2d::Costmap2D::mutex_t> lock(*costmap_->getMutex());
+  unsigned int mx, my;
+  if (!costmap_->worldToMap(position.x, position.y, mx, my)) {
+    return false;
+  }
+
+  const auto* costs = costmap_->getCharMap();
+  const auto start = costmap_->getIndex(mx, my);
+  if (costs[start] >= INSCRIBED_INFLATED_OBSTACLE) {
+    return false;
+  }
+
+  const double resolution = costmap_->getResolution();
+  std::vector<bool> seen(costmap_->getSizeInCellsX() * costmap_->getSizeInCellsY(), false);
+  std::queue<std::pair<unsigned int, unsigned int>> pending;
+  pending.emplace(start, 0);
+  seen[start] = true;
+  bool found = false;
+  size_t best_visit = visited.size() + 1;
+  double best_score = 0.0;
+  while (!pending.empty()) {
+    const auto cell = pending.front().first;
+    const auto steps = pending.front().second;
+    pending.pop();
+
+    if ((steps + 1) * resolution <= max_path_length) {
+      for (const auto neighbor : nhood4(cell, *costmap_)) {
+        if (!seen[neighbor] && costs[neighbor] < INSCRIBED_INFLATED_OBSTACLE) {
+          seen[neighbor] = true;
+          pending.emplace(neighbor, steps + 1);
+        }
+      }
+    }
+
+    // Only stop at a clear cell, even though the approach may cross inflation costs.
+    if (costs[cell] != FREE_SPACE || steps * resolution < min_distance) {
+      continue;
+    }
+    geometry_msgs::msg::Point point;
+    costmap_->indexToCells(cell, mx, my);
+    costmap_->mapToWorld(mx, my, point.x, point.y);
+    if (std::hypot(point.x - position.x, point.y - position.y) < min_distance ||
+        std::any_of(failed.begin(), failed.end(), [&point](const auto& goal) {
+          return std::hypot(point.x - goal.x, point.y - goal.y) < min_distance;
+        })) {
+      continue;
+    }
+
+    // Prefer viewpoints away from recent visits. If all are familiar, revisit the oldest.
+    size_t last_visit = 0;
+    for (size_t i = 0; i < visited.size(); ++i) {
+      if (std::hypot(point.x - visited[i].x, point.y - visited[i].y) < min_distance) {
+        last_visit = i + 1;
+      }
+    }
+    const double score = std::abs(steps * resolution - desired_distance);
+    if (last_visit < best_visit || (last_visit == best_visit && score < best_score)) {
+      best_visit = last_visit;
+      best_score = score;
+      target = point;
+      found = true;
+    }
+  }
+  return found;
+}
+
