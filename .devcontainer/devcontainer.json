{
    "name": "ROS2 Humble",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "workspaceFolder": "/workspace",

    "mounts": [
        "source=${localWorkspaceFolder}/ros2_ws,target=/workspace,type=bind"
    ],

    "runArgs": [
        "--network=host",
        "--privileged"
    ]
}
